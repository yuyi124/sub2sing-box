{
  "log": {
    "disabled": true,
    "level": "error",
    "timestamp": false
  },
  "dns": {
    "fakeip": {
      "enabled": true,
      "inet4_range": "198.18.0.0/15",
      "inet6_range": "fc00::/18"
    },
    "servers": [
      {
        "tag": "ali-https",
        "address": "https://223.5.5.5/dns-query",
        "address_strategy": "prefer_ipv6",
        "detour": "DIRECT"
      },
      {
        "tag": "cloudflare-https",
        "address": "https://cloudflare-dns.com/dns-query",
        "address_resolver": "ali-https",
        "address_strategy": "prefer_ipv6",
        "detour": "PROXY"
      },
      {
        "tag": "adguard-quic",
        "address": "dns.adguard-dns.com",
        "address_resolver": "ali-https",
        "address_strategy": "ipv4_only",
        "detour": "PROXY"
      },
      {
        "tag": "refused",
        "address": "rcode://refused"
      },
      {
        "tag": "fakeip",
        "address": "fakeip"
      }
    ],
    "rules": [
      {
        "outbound": "any",
        "server": "ali-https"
      },
      {
        "query_type": [
          "HTTPS",
          "A",
          "AAAA",
          "NS",
          "CNAME",
          "TXT",
          "MX"
        ],
        "invert": true,
        "action": "reject",
        "method": "default"
      },
      {
        "protocol": "quic",
        "server": "adguard-quic"
      },
      {
        "clash_mode": "Direct",
        "server": "ali-https"
      },
      {
        "clash_mode": "Global",
        "server": "cloudflare-https"
      },
      {
        "rule_set": [
          "geosite-google",
          "geosite-globalsign"
        ],
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "fakeip"
      },
      {
        "rule_set": [
          "geosite-geolocation-cn",
          "geosite-cn",
          "geosite-category-games@cn",
          "geosite-steam@cn",
          "geosite-apple@cn"
        ],
        "server": "ali-https"
      },
      {
        "rule_set": [
          "geosite-geolocation-!cn"
        ],
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "fakeip"
      }
    ],
    "final": "cloudflare-https",
    "strategy": "prefer_ipv6"
  },
  "inbounds": [
    {
      "type": "tun",
      "address": [
        "172.16.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "strict_route": true,
      "sniff": true
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "DIRECT"
    },
    {
      "type": "selector",
      "tag": "PROXY",
      "outbounds": [
        "<all-country-tags>",
        "DIRECT"
      ]
    },
    {
      "type": "urltest",
      "tag": "自动选择",
      "outbounds": [
        "<all-proxy-tags>"
      ]
    }
  ],
  "route": {
    "rules": [
      {
        "port": [
          3478,
          5348,
          5349
        ],
        "outbound": "DIRECT"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "protocol": [
          "ssh"
        ],
        "outbound": "DIRECT"
      },
      {
        "clash_mode": "Direct",
        "outbound": "DIRECT"
      },
      {
        "clash_mode": "Global",
        "outbound": "PROXY"
      },
      {
        "rule_set": [
          "custom-reject"
        ],
        "action": "reject"
      },
      {
        "rule_set": [
          "geosite-google",
          "geosite-globalsign"
